        {
          "name": "Coding agent",
          "actorDocument": "Actors/coding-agent.md"
        }
      ],
      "goal": "See a change to a game live on icelander.net.",
      "preconditions": [
        "The change is on a branch, not on main: main takes only pull requests.",
        "The game's own tests pass in its folder (npm test)."
      ],
      "postconditions": [
        "Each game the change touched, outside its .dev folders, runs the merged code on icelander.net.",
        "A change to .dev files alone is on main and nothing was deployed."
      ],
      "flow": [
        {
          "id": "open",
          "actor": "Coding agent",
          "participantKind": "actor",
          "actorDocument": "Actors/coding-agent.md",
          "action": "Pushes the branch and opens a pull request.",
