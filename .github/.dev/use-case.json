      "id": "ship-a-change",
      "name": "Ship a change to a game",
      "description": "A change made on a branch is checked on a pull request and, once merged, deployed to icelander.net.",
      "sources": [
        {
          "path": "AGENTS.md",
          "symbol": "Agent instructions"
        },
        {
          "path": ".github/workflows/ci.yml",
          "symbol": "jobs"
        },
        {
          "path": ".github/workflows/migrations.yml",
          "symbol": "jobs"
        },
        {
          "path": ".github/workflows/deploy.yml",
          "symbol": "jobs"
