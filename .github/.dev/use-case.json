  "entities": [
    {
      "id": "ship-a-change",
      "name": "Ship a change to a game",
      "description": "A change made on a branch is checked on a pull request and merged; the owner then deploys each game it changed to icelander.net from their own machine.",
      "sources": [
        {
          "path": "AGENTS.md",
          "symbol": "Agent instructions"
        },
        {
          "path": ".github/workflows/ci.yml",
          "symbol": "jobs"
        },
        {
          "path": ".github/workflows/migrations.yml",
          "symbol": "jobs"
        },
        {
          "path": "README.md",
          "symbol": "Deploying"
        }
      ],
      "actor": "Owner",
      "actorDocument": "Actors/owner.md",
      "supportingActors": [
        {
          "name": "Coding agent",
          "actorDocument": "Actors/coding-agent.md"
        }
      ],
      "goal": "See a change to a game live on icelander.net.",
      "preconditions": [
        "The change is on a branch, not on main: main takes only pull requests.",
        "The game's own tests pass in its folder (npm test)."
      ],
      "postconditions": [
        "The change is on main; merging deployed nothing.",
        "Each game the owner deployed runs the merged code on icelander.net."
      ],
      "flow": [
        {
          "id": "open",
          "actor": "Coding agent",
          "participantKind": "actor",
          "actorDocument": "Actors/coding-agent.md",
          "action": "Pushes the branch and opens a pull request.",
          "sources": [
            {
              "path": "AGENTS.md",
              "symbol": "Agent instructions"
            }
          ]
        },
        {
          "id": "ci",
          "actor": "CI",
          "participantKind": "system",
          "action": "Validates every .dev file, lists the changed games, and tests and builds each one.",
          "sources": [
            {
              "path": ".github/workflows/ci.yml",
              "symbol": "jobs"
            },
            {
              "path": ".github/scripts/changed-games.sh",
              "symbol": "all"
            },
            {
              "path": ".github/workflows/game.yml",
              "symbol": "jobs"
            }
          ]
        },
        {
          "id": "migration-check",
          "actor": "Database migration check",
          "participantKind": "system",
          "action": "Passes when the pull request changes no database file, or acknowledges the migration.",
          "sources": [
            {
              "path": ".github/workflows/migrations.yml",
              "symbol": "jobs"
            },
            {
              "path": ".github/scripts/migration-gate.sh",
              "symbol": "pr"
            }
          ]
        },
        {
          "id": "merge",
          "actor": "Owner",
          "participantKind": "actor",
          "actorDocument": "Actors/owner.md",
          "action": "Merges the pull request, which deploys nothing.",
          "sources": [
            {
              "path": "AGENTS.md",
              "symbol": "Agent instructions"
            }
          ]
        },
        {
          "id": "deploy",
          "actor": "Owner",
          "participantKind": "actor",
          "actorDocument": "Actors/owner.md",
          "action": "Deploys each game the change touched from their own machine: npm run deploy in the game's folder tests it, builds it and runs wrangler deploy.",
          "sources": [
            {
              "path": "README.md",
              "symbol": "Deploying"
            },
            {
              "path": "games/rally/package.json",
              "symbol": "scripts.deploy"
            }
          ]
        }
      ],
      "alternatives": [
        {
          "atStep": "ci",
          "condition": "The pull request changes only .dev files, outside .github/ or not.",
          "outcome": "No game is tested; the validators still run, and there is no game to deploy.",
          "sources": [
            {
              "path": ".github/scripts/changed-games.sh",
              "symbol": "all"
            }
          ]
        },
        {
          "atStep": "ci",
          "condition": "A validator, a game's tests or its build fail, or the build holds a .dev folder.",
          "outcome": "That job fails on the pull request.",
          "sources": [
            {
              "path": ".github/workflows/ci.yml",
              "symbol": "jobs"
            },
            {
              "path": ".github/workflows/game.yml",
              "symbol": "No .dev files in the build"
            }
          ]
        },
        {
          "atStep": "migration-check",
          "condition": "A database file changed and the description has no acknowledgement.",
          "outcome": "The check fails and main refuses the merge until the migration is applied and acknowledged (Migrate a game's database).",
          "sources": [
            {
              "path": ".github/scripts/migration-gate.sh",
              "symbol": "pr"
            },
            {
              "path": "docs/database-migrations.md",
              "symbol": "Database migrations"
            }
          ]
        },
        {
          "atStep": "deploy",
          "condition": "The change touches a game's database.",
          "outcome": "No gate runs before the deploy: the Database migration check on the pull request is the only one, so the migration must already be applied (Migrate a game's database).",
          "sources": [
            {
              "path": "docs/database-migrations.md",
              "symbol": "Database migrations"
            },
            {
              "path": "README.md",
              "symbol": "Deploying"
            }
          ]
        },
        {
          "atStep": "deploy",
          "condition": "A game's tests or build fail.",
          "outcome": "npm run deploy stops before wrangler deploy, and that game stays as it was.",
          "sources": [
            {
              "path": "games/rally/package.json",
              "symbol": "scripts.deploy"
            }
          ]
        }
      ]
    }
  ],
