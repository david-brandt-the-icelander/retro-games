{
  "name": "advent-calendar",
  "version": "1.0.0",
  "private": true,
  "description": "A storybook Advent calendar in the browser, for players invited to games:advent-calendar.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "test": "tsc --noEmit && node build.mjs --test && node --no-warnings --test dist-test/*.test.mjs",
    "dev": "node build.mjs && wrangler dev",
    "deploy": "npm test && npm run build && wrangler deploy"
  },
  "license": "MPL-2.0",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "wrangler": "^4.163.0"
  }
}
