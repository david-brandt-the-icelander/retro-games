// The Laumufarþegi Worker at icelander.net/games/fresh/laumufarthegi: the page (dist/), a small API and one Durable
// Object per room (worker/room.ts). No database and no secrets: a room lives in its object's storage and deletes
// itself after a day without use. Deployed by .github/workflows/deploy.yml on a merge to main (README "Deploy").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laumufarthegi",
  "compatibility_date": "2025-06-01",
  "workers_dev": false,
  "preview_urls": false,
  // Its route runs before the games hub (the recreations Worker), whose route icelander.net/games/* is less specific.
  "routes": [{ "pattern": "icelander.net/games/fresh/laumufarthegi*", "zone_name": "icelander.net" }],
  "main": "worker/index.ts",
  // The Worker answers the API under {BASE}/api/ and sets the page's caching; everything else is a static asset.
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "run_worker_first": ["/games/fresh/laumufarthegi", "/games/fresh/laumufarthegi/", "/games/fresh/laumufarthegi/index.html", "/games/fresh/laumufarthegi/api/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "rooms-v1", "new_sqlite_classes": ["Room"] }],
  // icelander.net's login service: who is signed in, through the site's cookie. Only starting a room needs it.
  "services": [{ "binding": "ACCOUNTS", "service": "accounts", "entrypoint": "Internal" }],
  "vars": {
    // The login service's public keys (icelander.net docs/accounts.md, "Keys").
    "ACCOUNTS_JWKS": "{\"keys\":[{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"kid\":\"k2026a\",\"x\":\"WIEomi0LTalJvQndhD7abl8ty3YcliQ0vEz4XjLXayc\"}]}",
    // "none" lets anyone start a room; any other value needs icelander.net's sign-in with HOST_ROLE to start one.
    // Joining a room never needs a sign-in.
    "HOST_SIGN_IN": "required",
    // Starting a room is invite-only: the role is declared in the icelander.net repository (accounts/src/config.js)
    // and granted, or sent as an invitation, at icelander.net/private/admin.
    "HOST_ROLE": "games:laumufarthegi"
  }
}
