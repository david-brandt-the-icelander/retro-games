// The Kvarðinn Worker at icelander.net/games/kvardinn: the page, and the game rooms as
// Durable Objects (worker/room.ts), all for players signed in to icelander.net who hold the
// invite-only role games:kvardinn (worker/handler.ts). No database, no secrets.
// Deployed by hand with `npm run deploy` (README.md, "Hosting"); nothing deploys from GitHub.
//
// `wrangler deploy --env standalone` instead puts the same game, open to anyone with the link and
// without icelander.net's sign-in, at the root of a workers.dev address on whatever Cloudflare
// account wrangler is logged in to.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kvardinn",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "workers_dev": false,
  "preview_urls": false,
  // Its route runs before the games hub (the recreations Worker), whose route icelander.net/games/* is less specific.
  "routes": [{ "pattern": "icelander.net/games/kvardinn*", "zone_name": "icelander.net" }],
  // Every request goes through the Worker first: nothing here is public.
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "rooms-v1", "new_sqlite_classes": ["Room"] }],
  // icelander.net's login service: who is signed in, through the site's cookie (icelander.net and its games are one sign-in).
  "services": [{ "binding": "ACCOUNTS", "service": "accounts", "entrypoint": "Internal" }],
  "vars": {
    "BASE": "/games/kvardinn",
    // The login service's public keys (icelander.net docs/accounts.md, "Keys").
    "ACCOUNTS_JWKS": "{\"keys\":[{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"kid\":\"k2026a\",\"x\":\"WIEomi0LTalJvQndhD7abl8ty3YcliQ0vEz4XjLXayc\"}]}"
  },
  "env": {
    "standalone": {
      "name": "kvardinn",
      "workers_dev": true,
      "routes": [],
      "services": [],
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
      "vars": { "BASE": "", "OPEN": "1" }
    }
  }
}
