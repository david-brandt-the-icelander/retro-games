{
  "name": "chess",
  "version": "0.1.0",
  "private": true,
  "description": "Pixel Chess: chess with friends online (challenge by email) or against Stockfish at eight strengths, with sign-in, contacts and game history.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "test": "tsc --noEmit && node build.mjs --test && node --no-warnings --test dist-test/*.test.mjs",
    "dev": "node build.mjs && wrangler dev",
    "deploy": "npm test && npm run build && wrangler deploy"
  },
  "license": "MPL-2.0",
  "dependencies": {
    "chess.js": "^1.4.0",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  }
}
