# Copy to .dev.vars for `npm run dev`. DEV_LOGIN=1 adds a sign-in that takes any email address
# (GET /games/retro/chess/auth/dev?email=…), for testing two players on one machine. Never set it in production.
DEV_LOGIN=1
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# RESEND_API_KEY=
