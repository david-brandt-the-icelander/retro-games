          "participantKind": "actor",
          "actorDocument": "Actors/player.md"
        },
        {
          "id": "list",
          "actor": "Game",
          "action": "Shows the lobby, with the invitation under Invitations for you: who sent it, the colour the player gets and when.",
          "sources": [
            {
              "path": "games/chess/godot/scripts/main.gd",
              "symbol": "Main._fill_incoming"
            }
          ],
          "participantKind": "system"
        },
        {
          "id": "accept",
          "actor": "Player",
          "action": "Presses Accept (or Decline).",
          "sources": [
            {
              "path": "games/chess/godot/scripts/main.gd",
