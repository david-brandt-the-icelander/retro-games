      ],
      "actor": "Player",
      "goal": "Get a game going with a friend, wherever they are.",
      "preconditions": [
        "The player is signed in.",
        "The Friends screen (the lobby) is showing."
      ],
      "postconditions": [
        "An open invitation from the player to that address is stored, with the player's colour.",
        "The player has a link to the invitation; the friend has it by email when email is set up."
      ],
      "flow": [
        {
          "id": "address",
          "actor": "Player",
          "action": "Types the friend's email address and chooses White, Random or Black.",
