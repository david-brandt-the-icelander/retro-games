// The chess Worker at icelander.net/games/retro/chess: static assets, sign-in, the API, and a
// Durable Object per online game, backed by the D1 database "chess" (schema: worker/schema.sql).
//
// Before the first deploy (owner actions; see README "Deploy"):
//   npx wrangler d1 create chess        → put its id in database_id below
//   npx wrangler d1 execute chess --remote --file worker/schema.sql
//   (sign-in is icelander.net's login service now: no OAuth secrets here; README "Sign-in")
//   (optional) npx wrangler secret put RESEND_API_KEY, and set MAIL_FROM below
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chess",
  "compatibility_date": "2025-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "icelander.net/games/retro/chess*", "zone_name": "icelander.net" }],
  "main": "worker/index.ts",
  // The Worker runs first for the API, sign-in and the joined engine file; everything else is a static asset.
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "run_worker_first": ["/games/retro/chess/", "/games/retro/chess/index.html", "/games/retro/chess/api/*", "/games/retro/chess/auth/*", "/games/retro/chess/index.wasm"] },
  // icelander.net's login service: who is signed in, through the site's cookie (icelander.net and its games are one sign-in) (worker/auth.ts).
  "services": [{ "binding": "ACCOUNTS", "service": "accounts", "entrypoint": "Internal" }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }] },
  "migrations": [{ "tag": "rooms-v1", "new_sqlite_classes": ["GameRoom"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "chess", "database_id": "8c4255e7-b890-4839-a821-65f1483d776e" }],
  "vars": {
    // The login service's public keys (icelander.net docs/accounts.md, "Keys").
    "ACCOUNTS_JWKS": "{\"keys\":[{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"kid\":\"k2026a\",\"x\":\"WIEomi0LTalJvQndhD7abl8ty3YcliQ0vEz4XjLXayc\"}]}",
    // The sender of challenge emails, e.g. "Gambit <chess@icelander.net>"; empty sends none.
    "MAIL_FROM": ""
  }
}
