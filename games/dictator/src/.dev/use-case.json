    {
      "id": "reign-and-enter-table",
      "name": "Play a reign and enter the table",
      "description": "A player takes power, rules until killed or gone, and puts the reign on the public high-score table.",
      "sources": [
        {
          "path": "games/dictator/src/main.ts",
          "symbol": "title"
        },
        {
          "path": "games/dictator/src/main.ts",
          "symbol": "offerTable"
        }
      ],
      "actor": "Player",
      "goal": "Play a reign and see it ranked on the table.",
      "preconditions": [
        "The player is signed in to icelander.net with the games:play role.",
        "The title screen is showing."
      ],
      "postconditions": [
        "The reign's score, as the server's replay computed it, is on the table under the player's name.",
        "The name is saved for the browser session, and the best rating in this browser."
      ],
      "flow": [
        {
          "id": "take-power",
          "actor": "Player",
          "action": "Presses any key on the title other than H, A or S.",
          "sources": [
            {
              "path": "games/dictator/src/main.ts",
              "symbol": "title"
            }
          ],
          "participantKind": "actor",
          "actorDocument": "Actors/player.md"
        },
        {
          "id": "seed",
          "actor": "Page",
          "action": "Asks the server for the reign's seed, starts an empty key log and starts the reign with the best rating in this browser.",
          "sources": [
            {
              "path": "games/dictator/src/scores.ts",
              "symbol": "startReign"
            },
            {
              "path": "games/dictator/src/main.ts",
              "symbol": "loadBest"
            }
          ],
          "participantKind": "system"
        },
        {
          "id": "rule",
          "actor": "Player",
          "action": "Plays the reign month by month, answering each screen with one key, until killed or escaped.",
          "sources": [
            {
              "path": "games/dictator/src/main.ts",
              "symbol": "io"
            },
            {
              "path": "games/dictator/src/main.ts",
              "symbol": "present"
            }
          ],
          "participantKind": "actor",
          "actorDocument": "Actors/player.md"
        },
        {
          "id": "offer",
          "actor": "Page",
          "action": "Keeps the best rating, then shows the name entry, filled in with the session's name or the signed-in player's.",
          "sources": [
            {
              "path": "games/dictator/src/main.ts",
              "symbol": "offerTable"
            },
            {
              "path": "games/dictator/src/scores.ts",
              "symbol": "defaultName"
            }
          ],
          "participantKind": "system"
        },
        {
          "id": "name",
          "actor": "Player",
          "action": "Types or corrects the name on the keyboard or the keys drawn on screen, and presses ENTER.",
          "sources": [
            {
              "path": "games/dictator/src/main.ts",
              "symbol": "tappedKey"
