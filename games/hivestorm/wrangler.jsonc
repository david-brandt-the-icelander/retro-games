// The Hivestorm Worker at icelander.net/games/retro/hivestorm: the static game, open to everyone, plus
// the high-score API (worker/index.ts) backed by the D1 database hivestorm-scores (schema: worker/schema.sql).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hivestorm",
  "compatibility_date": "2025-01-01",
  "workers_dev": false,
  "preview_urls": false,
  // Its own route is more specific than the recreations Worker's icelander.net/games/*, so it wins.
  "routes": [{ "pattern": "icelander.net/games/retro/hivestorm*", "zone_name": "icelander.net" }],
  // The Worker serves the high-score API under /games/retro/hivestorm/api/ and the page .../scores/;
  // everything else is a static asset.
  "main": "worker/index.ts",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  // The online rooms that were here moved to the games hub (icelander.net/games/multiplayer); this
  // deletes their Durable Object class. Keep both entries: Cloudflare applies migrations in order.
  "migrations": [
    { "tag": "rooms-v1", "new_sqlite_classes": ["Room"] },
    { "tag": "rooms-v2", "deleted_classes": ["Room"] }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "hivestorm-scores", "database_id": "c29ed586-3080-4efa-9fc6-2a50330591f4" }]
}
