// The Thrustbound Worker at icelander.net/games/retro/thrustbound: the static Godot game, for anyone signed in.
// No database and no secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thrustbound",
  "compatibility_date": "2025-01-01",
  "workers_dev": false,
  "preview_urls": false,
  // Its route runs before the games hub, whose route icelander.net/games/* is less specific.
  "routes": [{ "pattern": "icelander.net/games/retro/thrustbound*", "zone_name": "icelander.net" }],
  "main": "worker/index.ts",
  // The Worker runs first for the page (sign-in) and the joined engine file; everything else is a static asset.
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "run_worker_first": ["/games/retro/thrustbound/", "/games/retro/thrustbound/index.html", "/games/retro/thrustbound/index.wasm"] },
  // icelander.net's login service: who is signed in, through the site's cookie.
  "services": [{ "binding": "ACCOUNTS", "service": "accounts", "entrypoint": "Internal" }],
  // The login service's public keys (icelander.net docs/accounts.md, "Keys").
  "vars": { "ACCOUNTS_JWKS": "{\"keys\":[{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"kid\":\"k2026a\",\"x\":\"WIEomi0LTalJvQndhD7abl8ty3YcliQ0vEz4XjLXayc\"}]}" }
}
