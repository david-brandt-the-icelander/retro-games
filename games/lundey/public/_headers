# Cloudflare static-asset headers for Lundey. Everything comes from this origin; no inline script, no inline style.
# The Worker serves every file to invited, signed-in players and marks it private (worker/index.ts).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Robots-Tag: noindex
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
