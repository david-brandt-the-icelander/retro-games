; LodeStar's Godot project. The rules are Rust (src/lib.rs and the crates under src/);
; this project is the picture. See docs/DESIGN.md.

config_version=5

[application]

config/name="LodeStar"
config/description="A space trading and combat game for the desktop."
run/main_scene="res://src/presentation/game/game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

; The Modern layout of docs/DESIGN.md § Keyboard controls, with RULES D.5's actions. The charts
