      "default": "none",
      "sensitive": false,
      "scope": "per run",
      "takesEffect": "at-startup",
      "evidenceStatus": "source-verified",
      "sources": [
        {
          "path": "games/lodestar/src/presentation/game/game.gd",
          "symbol": "_shot_path"
        }
      ]
    },
    {
      "id": "frames",
      "title": "Frames before the screenshot",
      "summary": "How many frames run before --shot is saved.",
      "key": "--frames=<n>",
      "type": "integer",
      "default": "0",
      "sensitive": false,
      "scope": "per run",
      "takesEffect": "at-startup",
      "evidenceStatus": "source-verified",
      "sources": [
        {
          "path": "games/lodestar/src/presentation/game/game.gd",
          "symbol": "_shot_frames"
        }
      ]
    },
    {
      "id": "script",
      "title": "Scripted game",
      "summary": "Play a scripted game with the sim's clock stopped: a step list, @smoke or @shots.",
      "key": "--script=<steps>",
      "type": "string",
      "default": "none",
      "sensitive": false,
      "scope": "per run",
      "takesEffect": "at-startup",
      "evidenceStatus": "source-verified",
      "sources": [
        {
          "path": "games/lodestar/src/presentation/game/game.gd",
          "symbol": "runner"
        }
      ]
    },
    {
      "id": "shots",
      "title": "Screenshot folder",
