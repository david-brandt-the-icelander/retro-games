{
  "$schema": "../../../../../../Meta/Agents/Knowledge/schemas/configuration.schema.json",
  "kind": "configuration",
  "title": "Game scene configuration",
  "folder": "games/lodestar/src/presentation/game",
  "entities": [
    {
      "id": "shot",
      "title": "Screenshot path",
      "summary": "Save one screenshot and quit.",
