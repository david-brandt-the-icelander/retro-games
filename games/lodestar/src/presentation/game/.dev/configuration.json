      "key": "--shots=<folder>",
      "type": "path",
      "default": "user://shots",
      "sensitive": false,
      "scope": "per run",
      "takesEffect": "at-startup",
      "evidenceStatus": "source-verified",
      "sources": [
        {
          "path": "games/lodestar/src/presentation/game/script_runner.gd",
          "symbol": "_shots_folder"
        }
      ]
    },
    {
      "id": "input-map",
      "title": "Input map",
      "summary": "The keys of DESIGN's Modern layout under RULES D.5's action names.",
      "key": "project.godot [input]",
      "type": "Godot InputMap actions",
      "default": "the Modern layout",
      "sensitive": false,
      "scope": "per project",
      "takesEffect": "at-startup",
      "evidenceStatus": "source-verified",
      "sources": [
        {
          "path": "games/lodestar/project.godot",
          "symbol": "input"
        }
