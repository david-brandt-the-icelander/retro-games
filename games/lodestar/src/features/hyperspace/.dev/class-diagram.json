    { "path": "games/lodestar/src/features/hyperspace/countdown.rs", "symbol": "Destination" },
    { "path": "games/lodestar/src/features/hyperspace/jump.rs", "symbol": "HyperspaceKey" },
    { "path": "games/lodestar/src/features/hyperspace/jump.rs", "symbol": "GalaxyDriveKey" },
    { "path": "games/lodestar/src/features/hyperspace/jump.rs", "symbol": "Tunnel" },
