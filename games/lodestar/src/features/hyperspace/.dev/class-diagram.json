  ],
  "relationships": [
    { "from": "countdown", "to": "destination", "kind": "depends-on", "description": "Holds where the running countdown leads." },
    { "from": "countdown", "to": "universe", "kind": "depends-on", "description": "Range-checks a retarget with in_range (deliberate difference 6)." },
    { "from": "navigation", "to": "countdown", "kind": "depends-on", "description": "Each selection may retarget a running countdown." },
    { "from": "navigation", "to": "universe", "kind": "depends-on", "description": "The cursor selects the nearest system and measures its distance." },
    { "from": "jump", "to": "hyperspace-key", "kind": "depends-on", "description": "Reports what the hyperspace key did." },
    { "from": "jump", "to": "galaxy-drive-key", "kind": "depends-on", "description": "Reports what the galaxy-drive key did." },
    { "from": "jump", "to": "tunnel", "kind": "depends-on", "description": "The jump returns the tunnel; the arrival takes it back." },
    { "from": "jump", "to": "arrived", "kind": "depends-on", "description": "Reports where the arrival left the pilot." },
    { "from": "jump", "to": "navigation", "kind": "depends-on", "description": "Selects, and updates the current system on arrival." },
    { "from": "jump", "to": "countdown", "kind": "depends-on", "description": "Starts the countdown from the keys." },
    { "from": "jump", "to": "universe", "kind": "depends-on", "description": "Fuel, the mis-jump test and position, and the Reach jump." },
    { "from": "jump", "to": "market", "kind": "depends-on", "description": "The common arrival draws the market byte." },
    { "from": "jump", "to": "cockpit", "kind": "depends-on", "description": "Resets the flight state and enters the Deep." },
    { "from": "jump", "to": "planet-and-sun", "kind": "depends-on", "description": "Places the planet and sun on arrival." },
    { "from": "jump", "to": "spawning", "kind": "depends-on", "description": "Fills the Deep with alien groups; resets the spawn delay on arrival." }
  ]
