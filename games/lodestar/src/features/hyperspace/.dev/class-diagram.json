      "sources": ["games/lodestar/src/features/hyperspace/jump.rs"],
      "members": [
        "press_hyperspace(navigation, countdown, pilot, docked) -> HyperspaceKey",
        "press_galaxy_drive(countdown, pilot, docked) -> GalaxyDriveKey",
        "jump(destination, pilot, navigation, cockpit, random) -> Tunnel",
        "arrive(tunnel, pilot, cockpit, bubble, navigation, delay, random) -> Arrived"
