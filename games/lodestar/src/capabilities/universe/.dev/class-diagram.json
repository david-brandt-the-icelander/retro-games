  "relationships": [
    {
      "from": "galaxy",
      "to": "seed",
      "kind": "depends-on",
      "description": "Holds its system-0 state and advances it four steps per system."
    },
    {
      "from": "galaxy",
      "to": "system",
      "kind": "depends-on",
      "description": "Builds systems from their states; searches their positions for the nearest."
    },
    {
      "from": "system",
      "to": "seed",
      "kind": "depends-on",
      "description": "Every property, the name and the inhabitants are worked out from the state's six bytes."
    },
    {
      "from": "system",
      "to": "planet-style",
      "kind": "depends-on",
      "description": "Bit 1 of the tech level chooses the planet's look."
    },
    {
      "from": "system",
      "to": "vec3",
      "kind": "depends-on",
      "description": "Returns the planet's and sun's arrival positions."
    },
    {
      "from": "selection",
      "to": "point",
      "kind": "depends-on",
      "description": "Carries the selected system's position."
    },
    {
      "from": "chart-cursor",
      "to": "selection",
      "kind": "depends-on",
      "description": "Selecting from the cursor returns a selection and snaps the cursor onto it."
    },
    {
      "from": "chart-cursor",
      "to": "galaxy",
      "kind": "depends-on",
      "description": "Searches the galaxy for the system nearest the cursor."
    },
    {
      "from": "chart-cursor",
      "to": "arrow",
      "kind": "depends-on",
      "description": "Moves one unit per tap."
    },
    {
      "from": "chart-cursor",
      "to": "held-arrows",
      "kind": "depends-on",
      "description": "Repeats held arrows when docked, on even ticks."
    },
    {
      "from": "local-chart-entry",
      "to": "system",
      "kind": "depends-on",
      "description": "Built by local_chart from each system's position and disc radius."
    }
  ]
