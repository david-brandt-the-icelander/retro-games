// The Shatterbelt Worker at icelander.net/games/retro/shatterbelt: static assets, plus the high-score
// API and page (worker/index.ts) backed by the D1 database shatterbelt-scores (schema: worker/schema.sql).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shatterbelt",
  "compatibility_date": "2025-01-01",
  "workers_dev": false,
  "preview_urls": false,
  // Its own route is more specific than the recreations Worker's icelander.net/games/*, so it wins.
  // The old address, /retro-games/shatterbelt, is redirected here by the Worker.
  "routes": [
    { "pattern": "icelander.net/games/retro/shatterbelt*", "zone_name": "icelander.net" },
    { "pattern": "icelander.net/retro-games/shatterbelt*", "zone_name": "icelander.net" }
  ],
  // The Worker serves the high-score API under /games/retro/shatterbelt/api/ and the page at
  // /games/retro/shatterbelt/scores/; everything else is a static asset.
  "main": "worker/index.ts",
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "auto-trailing-slash" },
  // The online rooms that were here moved to the games hub (icelander.net/games/multiplayer); this
  // deletes their Durable Object class. Keep both entries: Cloudflare applies migrations in order.
  "migrations": [
    { "tag": "rooms-v1", "new_sqlite_classes": ["Room"] },
    { "tag": "rooms-v2", "deleted_classes": ["Room"] }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "shatterbelt-scores", "database_id": "932bf59f-05df-43ac-aa1d-9d63a42304b9" }]
}
