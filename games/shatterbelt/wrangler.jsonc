// The Shatterbelt Worker at icelander.net/retro-games/shatterbelt: static assets only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shatterbelt",
  "compatibility_date": "2025-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "icelander.net/retro-games/shatterbelt*", "zone_name": "icelander.net" }],
  "assets": { "directory": "./dist", "html_handling": "auto-trailing-slash" }
}
