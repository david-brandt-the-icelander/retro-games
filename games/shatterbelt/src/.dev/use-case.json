  "entities": [
    {
      "id": "fly-solo-and-enter-table",
      "name": "Fly alone and enter the table",
      "description": "A player flies a game alone and puts the score on the high-score table.",
      "sources": [
        {
          "path": "games/shatterbelt/src/main.ts",
          "symbol": "launch"
        },
        {
          "path": "games/shatterbelt/src/main.ts",
          "symbol": "afterGame"
        }
      ],
      "actor": "Player",
      "goal": "Fly as long as the ships last and see the score ranked on the table.",
      "preconditions": [
        "The player is signed in to icelander.net with the games:play role.",
        "The title screen is showing, and the page is not waiting to join an online game."
      ],
      "postconditions": [
        "The score, as the server's replay computed it, is on the public table under the player's name.",
        "If it makes this browser's top ten, it is kept there too."
      ],
      "flow": [
        {
          "id": "launch",
          "actor": "Player",
          "action": "Presses Space, Enter or fire, or taps LAUNCH.",
          "sources": [
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "handle"
            },
            {
              "path": "games/shatterbelt/src/render.ts",
              "symbol": "launchRect"
            }
          ],
          "participantKind": "actor",
          "actorDocument": "Actors/player.md"
        },
        {
          "id": "seed",
          "actor": "Page",
          "action": "Asks the server for the game's seed, starts a co-op game for one from it, and records every change of the controls.",
          "sources": [
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "launch"
            },
            {
              "path": "games/shatterbelt/src/net.ts",
              "symbol": "startGame"
            }
          ],
          "participantKind": "system"
        },
        {
          "id": "play",
          "actor": "Player",
          "action": "Flies until every ship is lost, with the keyboard, a gamepad or the touch buttons.",
          "sources": [
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "tick"
            },
            {
              "path": "games/shatterbelt/src/input.ts",
              "symbol": "Input.controls"
            }
          ],
          "participantKind": "actor",
          "actorDocument": "Actors/player.md"
        },
        {
          "id": "over",
          "actor": "Page",
          "action": "Shows the game over, then waits for a key or a tap.",
          "sources": [
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "tick"
            },
            {
              "path": "games/shatterbelt/src/render.ts",
              "symbol": "Renderer.gameOver"
            }
          ],
          "participantKind": "system"
        },
        {
          "id": "ask",
          "actor": "Page",
          "action": "Opens a form over the screen for a name, when the score would make the public top ten or this browser's.",
          "sources": [
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "afterGame"
            },
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "onPublicTable"
            },
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "askName"
            }
          ],
          "participantKind": "system"
        },
        {
          "id": "name",
          "actor": "Player",
          "action": "Types a name and presses SAVE or Enter.",
          "sources": [
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "askName"
            }
          ],
          "participantKind": "actor",
          "actorDocument": "Actors/player.md"
        },
        {
          "id": "keep",
          "actor": "Page",
          "action": "Cleans the name, and keeps the score in this browser's top ten if it makes it.",
          "sources": [
            {
              "path": "games/shatterbelt/src/name.ts",
              "symbol": "cleanName"
            },
            {
              "path": "games/shatterbelt/src/scores.ts",
              "symbol": "addScore"
            }
          ],
          "participantKind": "system"
        },
        {
          "id": "submit",
          "actor": "Page",
          "action": "Sends the seed's id, the recording and the name; the server replays the game.",
          "sources": [
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "submit"
            },
            {
              "path": "games/shatterbelt/src/net.ts",
              "symbol": "submitGame"
            }
          ],
          "participantKind": "system"
        },
        {
          "id": "table",
          "actor": "Page",
          "action": "Shows the score with its rank among all pilots, and reloads the public table for the title screen.",
          "sources": [
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "submit"
            },
            {
              "path": "games/shatterbelt/src/render.ts",
              "symbol": "Renderer.saved"
            }
          ],
          "participantKind": "system"
        }
      ],
      "alternatives": [
        {
          "atStep": "seed",
          "condition": "The server gives no seed within 2.5 s (unreachable, or refusing).",
          "outcome": "The game plays from a seed of the browser's own, with OFFLINE: SCORES STAY ON THIS DEVICE under the field; its score can only go on this browser's table.",
          "sources": [
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "launch"
            },
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "afterGame"
            }
          ]
        },
        {
          "atStep": "play",
          "condition": "The player presses P, START or PAUSE, presses Escape, or leaves the tab or window.",
          "outcome": "The game pauses; Escape (or a gamepad's Back) while paused quits to the title.",
          "sources": [
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "setPaused"
            },
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "handle"
            }
          ]
        },
        {
          "atStep": "ask",
          "condition": "The score makes neither table.",
          "outcome": "No form: back to the title.",
          "sources": [
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "afterGame"
            }
          ]
        },
        {
          "atStep": "name",
          "condition": "The name has no letter or digit.",
          "outcome": "The form says so and stays open.",
          "sources": [
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "askName"
            }
          ]
        },
        {
          "atStep": "name",
          "condition": "The player presses SKIP or Escape.",
          "outcome": "The score stays off both tables and the page returns to the title.",
          "sources": [
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "askName"
            },
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "afterGame"
            }
          ]
        },
        {
          "atStep": "submit",
          "condition": "The server can't be reached, or refuses the game.",
          "outcome": "The page says the score server couldn't be reached or couldn't confirm the game, and that scores that made this device's table are kept there.",
          "sources": [
            {
              "path": "games/shatterbelt/src/main.ts",
              "symbol": "submit"
