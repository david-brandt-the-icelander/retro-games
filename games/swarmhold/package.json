{
  "name": "swarmhold",
  "version": "0.1.0",
  "private": true,
  "description": "Swarmhold: an original rescue game in a walled desert city overrun by giant ants, made in Godot 4 for the web.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "test": "tsc --noEmit && node build.mjs --test && node --no-warnings --test dist-test/*.test.mjs",
    "test:godot": "godot --headless --path godot --import && godot --headless --path godot -- --autotest",
    "dev": "node build.mjs && wrangler dev",
    "deploy": "npm test && npm run test:godot && npm run build && wrangler deploy"
  },
  "license": "MPL-2.0",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  }
}
