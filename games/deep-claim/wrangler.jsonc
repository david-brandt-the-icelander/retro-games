// The Deep Claim Worker at icelander.net/games/retro/deep-claim: the static Godot game, for anyone
// signed in to icelander.net. No database: the game keeps nothing on the server.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deep-claim",
  "compatibility_date": "2025-01-01",
  "workers_dev": false,
  "preview_urls": false,
  // Its route runs before the games hub (the recreations Worker), whose route icelander.net/games/* is less specific.
  "routes": [{ "pattern": "icelander.net/games/retro/deep-claim*", "zone_name": "icelander.net" }],
  "main": "worker/index.ts",
  // The Worker runs first for the page (the sign-in) and the joined engine file; everything else is a static asset.
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "run_worker_first": ["/games/retro/deep-claim", "/games/retro/deep-claim/", "/games/retro/deep-claim/index.html", "/games/retro/deep-claim/index.wasm"] },
  // icelander.net's login service: who is signed in, through the site's cookie (icelander.net and its games are one sign-in).
  "services": [{ "binding": "ACCOUNTS", "service": "accounts", "entrypoint": "Internal" }],
  // The login service's public keys (icelander.net docs/accounts.md, "Keys").
  "vars": { "ACCOUNTS_JWKS": "{\"keys\":[{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"kid\":\"k2026a\",\"x\":\"WIEomi0LTalJvQndhD7abl8ty3YcliQ0vEz4XjLXayc\"}]}" }
}
