# Cloudflare static-asset headers. Everything the game needs is served from this origin, except
# Cloudflare Web Analytics: its beacon script (injected by Cloudflare) and the reports it sends.
# Online rooms are WebSockets to this origin, named outright for browsers whose 'self' leaves out wss:.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' wss://games.icelander.net https://cloudflareinsights.com; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
