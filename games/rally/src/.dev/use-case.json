      ],
      "actor": "Player",
      "goal": "Play a match against the computer and see it ranked on the table.",
      "preconditions": [
        "The player is signed in to icelander.net with the games:play role.",
        "The title screen is showing."
      ],
      "postconditions": [
        "The match's score, as the server's replay computed it, is on the table under the player's name.",
        "The name is saved for the browser session."
      ],
      "flow": [
        {
          "id": "choose",
