// The Rally Worker at icelander.net/games/retro/rally: static assets only, no server code.
// Its own route is more specific than the recreations Worker's icelander.net/games/*, so it wins.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rally",
  "compatibility_date": "2025-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "icelander.net/games/retro/rally*", "zone_name": "icelander.net" }],
  "assets": { "directory": "./dist", "not_found_handling": "none" }
}
