// The Rally Worker at games.icelander.net/retro/rally: the static game, plus the high-score API
// (worker/index.ts) backed by the D1 database rally-scores (schema: worker/schema.sql).
// Its route runs before the games hub (the recreations Worker), which is games.icelander.net's custom domain.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rally",
  "compatibility_date": "2025-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "games.icelander.net/retro/rally*", "zone_name": "icelander.net" }],
  // The Worker answers the API and the scores page under /retro/rally/; everything else is a static asset.
  "main": "worker/index.ts",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "none" },
  // The online rooms that were here moved to the games hub (games.icelander.net/multiplayer); this
  // deletes their Durable Object class. Keep both entries: Cloudflare applies migrations in order.
  "migrations": [
    { "tag": "rooms-v1", "new_sqlite_classes": ["Room"] },
    { "tag": "rooms-v2", "deleted_classes": ["Room"] }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "rally-scores", "database_id": "cfa22c0a-477c-4d43-9f93-a88614800caf" }]
}
