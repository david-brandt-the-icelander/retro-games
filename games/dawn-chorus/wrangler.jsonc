// The Dawn Chorus Worker at icelander.net/games/retro/dawn-chorus: the page, its photos and recordings, all for players
// signed in to icelander.net (worker/index.ts). No database, no secrets.
// Deployed by .github/workflows/deploy.yml on a merge to main (README "Deploy").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dawn-chorus",
  "compatibility_date": "2025-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "icelander.net/games/retro/dawn-chorus*", "zone_name": "icelander.net" }],
  "main": "worker/index.ts",
  // Every request goes through the Worker first: nothing here is public.
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "run_worker_first": true },
  // icelander.net's login service: who is signed in, through the site's cookie (icelander.net and its games are one sign-in).
  "services": [{ "binding": "ACCOUNTS", "service": "accounts", "entrypoint": "Internal" }],
  "vars": {
    // The login service's public keys (icelander.net docs/accounts.md, "Keys").
    "ACCOUNTS_JWKS": "{\"keys\":[{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"kid\":\"k2026a\",\"x\":\"WIEomi0LTalJvQndhD7abl8ty3YcliQ0vEz4XjLXayc\"}]}"
  }
}
