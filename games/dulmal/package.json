{
  "name": "dulmal",
  "version": "1.0.0",
  "private": true,
  "description": "Dulmál: an Icelandic team word-association party game for 4–8 players on their own phones, with real-time rooms in a Durable Object.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "test": "tsc --noEmit && node build.mjs --test && node --no-warnings --test dist-test/*.test.mjs",
    "dev": "node build.mjs && wrangler dev --ip 0.0.0.0",
    "deploy": "npm test && npm run build && wrangler deploy"
  },
  "license": "MPL-2.0",
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "wrangler": "^4.163.0"
  }
}
